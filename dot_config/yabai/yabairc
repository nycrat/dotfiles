yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config                 \
  layout           bsp          \
  window_placement second_child \

yabai -m config       \
  menubar_opacity 0.0 \
  window_shadow   off \

yabai -m config       \
  external_bar    all \
  window_gap      10  \
  top_padding     10  \
  bottom_padding  10  \
  left_padding    10  \
  right_padding   10  \

yabai -m rule --add app="Stats" manage=off
yabai -m rule --add app="Godot" manage=off
yabai -m rule --add app='^System Information$' manage=off

# Window borders using https://github.com/FelixKratz/JankyBorders
options=(
	style=round
	width=4.0
	hidpi=on
	active_color=0xbb5e4d70
	inactive_color=0x665e4d70
)
# active_color=0xbb907aa9
# inactive_color=0x66907aa9

borders "${options[@]}"

# Menubar using https://github.com/felixkratz/sketchybar
